venv/
__pycache__/
*.pyc
data/results/*.wav
data/test_samples/*.wav
logs/*.log
*.egg-info/
.pytest_cache/
.ruff_cache/

# local machine-specific config -- copy .env.example instead
.env

# large model binaries -- downloaded locally, not committed
models/piper/*.onnx
models/piper/*.onnx.json
models/ai4bharat_tts/
logs/*.csv
logs/_*.wav
# NOTE: data/results/accuracy_comparison.png and benchmark_results.csv are
# NOT ignored -- they're the real benchmark evidence (README section 5),
# not throwaway output, and are committed intentionally.

# editor/tool-specific state, not project content
.serena/
.playwright-mcp/


# generated intermediate artefact of docs/build_pdf.py -- regenerate with
# `python docs/build_pdf.py`; the source fragments and the final PDF are
# what's tracked, not this assembled scratch file.
docs/technical_documentation.html

# private cross-session working notes -- never pushed to GitHub
context.md

# continuous-learning feedback DB (src/learning/) -- local correction
# history, not sample/demo data; off by default (LEARNING_ENABLED=0)
data/learning/*.db
data/learning/*.db-wal
data/learning/*.db-shm
# audio segments for corrected transcripts -- off by default
# (LEARNING_PERSIST_AUDIO_ENABLED=0); personal voice data when it exists
data/learning/audio/*.wav
# versioned training datasets built from feedback (src/learning/dataset_builder.py)
data/learning/datasets/*
!data/learning/datasets/.gitkeep
# trained model artifacts and the registry pointing at them
data/learning/models/*
!data/learning/models/.gitkeep

# --- hardening additions ---
.venv/
env/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/

# any env file other than the committed template
.env.*
!.env.example

# runtime output: nothing under logs/ is source (keep only the placeholder)
logs/*
!logs/.gitkeep

