# Tells Claude Code which files to skip when searching/reading this repo.
# Mirrors .gitignore's reasoning (large/generated/binary, not source) plus a
# few source-tracked binaries that are still pointless to re-read every time.

venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# model weights and voice binaries -- large, binary, never worth reading
models/piper/*.onnx
models/piper/*.onnx.json
models/ai4bharat_tts/
*.pth
*.wav
*.gguf

# logs and local run output
logs/
server_check.log
server_demo.log
*.log

# editor/tool-specific state
.serena/
.playwright-mcp/

# continuous-learning local data (feedback DB, cached audio, generated
# datasets/models) -- large and/or personal, regenerated at runtime
data/learning/*.db
data/learning/*.db-wal
data/learning/*.db-shm
data/learning/audio/
data/learning/datasets/
data/learning/models/

# generated docs build artifacts (source fragments + docs/build_pdf.py are
# what matter; these are the assembled/rendered output)
docs/technical_documentation.html
docs/_summary.html
docs/*.pdf

# private cross-session working notes -- not project source
context.md

.git/
