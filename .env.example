# Copy this file to .env and edit as needed. All of these have sensible
# defaults (see src/config.py) -- .env only needs the ones you want to
# override. python-dotenv loads this automatically; nothing here is
# required for the project to run.

# --- STT ---
WHISPER_MODEL_SIZE=small

# --- confidence gating -- see confidence_check.py's docstring for how to
# re-tune this against your own logs/confidence_log.csv ---
CONFIDENCE_THRESHOLD=-0.6
# CONFIDENCE_LOG_PATH=logs/confidence_log.csv

# --- LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- TTS (Piper) -- usually auto-detected, override if you use a
# different voice model or a non-default install location ---
# PIPER_EXECUTABLE=C:\path\to\piper.exe
# PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx

# --- logging ---
# LOG_DIR=logs

# --- web front ends ---
CHAT_WEB_PORT=5006
RECORD_WEB_PORT=5005

# Set to 1 to serve chat_web.py / record_web.py via waitress (production
# WSGI server) instead of Flask's development server. See README section 7.
PRODUCTION=0
