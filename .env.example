# Copy this file to .env and edit as needed. All of these have sensible
# defaults (see src/config.py) -- .env only needs the ones you want to
# override. python-dotenv loads this automatically; nothing here is
# required for the project to run.

# --- STT ---
WHISPER_MODEL_SIZE=small
# "auto" detects English/Hindi/Tamil per utterance (needed for Hindi/Tamil
# support); set to "en"/"hi"/"ta" to force one instead of relying on
# detection. Tamil/Hindi accuracy benefits from "medium" or larger --
# "small" is tuned/verified for English only.
WHISPER_LANGUAGE=auto

# --- confidence gating -- see confidence_check.py's docstring for how to
# re-tune this against your own logs/confidence_log.csv ---
CONFIDENCE_THRESHOLD=-0.6
# CONFIDENCE_LOG_PATH=logs/confidence_log.csv

# --- LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
# Single model for all three languages -- see config.py's comment on
# ollama_model for why this replaced an earlier dual-model (English/Hindi
# + a separate Tamil-specialized model) setup: live comparison across
# several small/medium models found gemma3n:e2b the only one coherent in
# Tamil, Hindi, AND English, at just ~1.7GB VRAM.
OLLAMA_MODEL=gemma3n:e2b
# Tamil-specific override, if a future model needs the same escape hatch
# gemma3n:e2b made unnecessary. Empty means "no override, use OLLAMA_MODEL
# for Tamil too".
# OLLAMA_MODEL_TA=
# OLLAMA_AUTO_PULL_TA_MODEL=1

# --- TTS (Piper) -- usually auto-detected, override if you use a
# different voice model or a non-default install location ---
# PIPER_EXECUTABLE=C:\path\to\piper.exe
# PIPER_MODEL_PATH=models/piper/en_US-lessac-medium.onnx
# PIPER_MODEL_PATH_HI=models/piper/hi_IN-pratham-medium.onnx

# --- TTS (Tamil) -- Piper has no Tamil voice, so Tamil speech uses a
# separate engine (src/indic_tts.py, AI4Bharat's FastPitch+HiFiGAN
# checkpoint run through coqui-tts: ~1GB of packages, ~1.5GB checkpoint
# downloaded on first use, both CPU-only). On by default -- no manual
# pip install needed, indic_tts.py installs requirements-indic-tts.txt
# and downloads the checkpoint itself the first time Tamil speech is
# actually requested. Set to 0 to opt out (e.g. an English/Hindi-only
# deployment that wants to avoid the multi-GB download entirely).
# TAMIL_TTS_ENABLED=1

# --- logging ---
# LOG_DIR=logs

# --- web front ends ---
CHAT_WEB_PORT=5006
RECORD_WEB_PORT=5005

# Set to 1 to serve chat_web.py / record_web.py via waitress (production
# WSGI server) instead of Flask's development server. See README section 7.
PRODUCTION=0

# --- continuous learning: STT correction feedback (src/learning/) ---
# Master switch. Off by default -- /api/transcribe's response is unchanged
# from before this feature existed until this is set to 1. See README,
# "Continuous learning", for what each sub-flag does.
LEARNING_ENABLED=0
# LEARNING_FEEDBACK_ENABLED=1
# LEARNING_PERSONALIZED_CORRECTION_ENABLED=1
# LEARNING_CONTEXT_AWARE_ENABLED=1
# Rewrites the transcript sent to the LLM when a learned correction scores
# high enough. Off by default even when LEARNING_ENABLED=1 -- also has no
# effect while LEARNING_CONTEXT_AWARE_ENABLED=0.
# LEARNING_AUTO_APPLY_ENABLED=0
# LEARNING_DB_PATH=data/learning/feedback.db
# LEARNING_SUGGEST_THRESHOLD=0.6
# LEARNING_AUTO_APPLY_THRESHOLD=0.92
# LEARNING_RULE_FREQUENCY_SATURATION=5
# LEARNING_RULE_RECENCY_HALFLIFE_DAYS=30
# Persists the audio for a transcription ONLY if it is later corrected
# (see README, "Continuous learning" -- audio for everything else is never
# written to disk). Needed before dataset_builder.py has anything to build
# a real STT fine-tuning dataset from.
# LEARNING_PERSIST_AUDIO_ENABLED=0
# LEARNING_AUDIO_DIR=data/learning/audio

# --- continuous learning: automated scheduled fine-tuning (src/learning/scheduler.py) ---
# Master switch for the background training loop. Requires LEARNING_ENABLED=1
# too. Off by default -- with this off, chat_web.py behaves exactly as it did
# before this feature existed; training only ever happens if you run
# `python -m learning.training` (or `python -m learning.scheduler --once`)
# yourself. See README, "Continuous learning".
# LEARNING_AUTO_TRAINING_ENABLED=0
# How often the scheduler checks for enough new data. A check that finds
# too little data does nothing and waits for the next one.
# LEARNING_TRAINING_INTERVAL_MINUTES=60
# Minimum new corrected events (since the last attempted training run)
# required before a check actually triggers a training run.
# LEARNING_MIN_NEW_EVENTS_FOR_TRAINING=50
# LEARNING_TRAINING_LANGUAGE=en
# LEARNING_DATASETS_ROOT=data/learning/datasets
# LEARNING_MODELS_ROOT=data/learning/models
# LEARNING_REGISTRY_PATH=data/learning/models/registry.json
# LEARNING_SCHEDULER_STATE_PATH=data/learning/scheduler_state.json
# LEARNING_SCHEDULER_LOCK_PATH=data/learning/scheduler.lock
# A training lock older than this is assumed to belong to a crashed
# process, not a genuinely still-running job, and is reclaimed.
# LEARNING_TRAINING_LOCK_STALE_SECONDS=21600
# LEARNING_TRAINING_MIN_RELATIVE_IMPROVEMENT=0.05
# LEARNING_TRAINING_BASE_MODEL=openai/whisper-small
# LEARNING_TRAINING_BASELINE_MODEL=small
# LEARNING_TRAINING_DEVICE=cpu
# Whether a successful promotion also hot-swaps the LIVE chatbot onto the
# new model (no restart needed). If 0, promotion still updates the model
# registry but the running process keeps serving its current model.
# LEARNING_AUTO_DEPLOY_ENABLED=1
